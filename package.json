{
  "name": "cuse",
  "version": "0.3.9",
  "description": "1 つの Claude Code セッション（指揮役）が、同じマシンのほかの Claude Code セッション（配下）を見守り・指揮するための CLI とデスクトップアプリ",
  "type": "module",
  "main": "dist/gui/main.js",
  "bin": {
    "cuse": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "prompts",
    "skill"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && npm run build:gui",
    "build:gui": "npm run build:preload && vite build",
    "build:preload": "vite build --config vite.preload.config.ts",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "gui": "ELECTRON_RUN_AS_NODE= electron dist/gui/main.js",
    "gui:dev": "npm run build && npm run gui",
    "gui:package": "npm run build && chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper && electron-packager . --name=cuse --app-bundle-id=io.github.naokiishimura.cuse --icon=assets/icon.icns --out=release --overwrite --no-asar --ignore=\"^/(?!dist($|/)|prompts($|/)|skill($|/)|package\\.json$|node_modules($|/(node-pty|meow)($|/)))\" --ignore=\"^/node_modules/node-pty/(deps|third_party|src|build|scripts|node-addon-api|prebuilds/win32)\"",
    "icon": "node scripts/build-icon.mjs",
    "postgui:package": "for app in release/cuse-darwin-*/cuse.app; do codesign --force --deep --sign - \"$app\" && codesign --verify --deep --strict \"$app\" || exit 1; done",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.gui.json",
    "copies:check": "node scripts/check-cc-park-copies.mjs"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agents",
    "electron"
  ],
  "license": "MIT",
  "dependencies": {
    "electron": "^44.4.3",
    "meow": "^14.1.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "jsdom": "^29.1.1",
    "lowlight": "^3.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
